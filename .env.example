# EmailJS Configuration
# Get these from https://www.emailjs.com/

# Your EmailJS Service ID (found in Email Services section)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Your EmailJS Template ID (found in Email Templates section)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Your EmailJS Public Key (found in Account → General section)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Instructions:
# 1. Copy this file and rename to .env
# 2. Replace the values with your actual EmailJS credentials
# 3. Never commit .env file to git (it's in .gitignore)
